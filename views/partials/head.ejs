<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <!-- PWA & Mobile Optimization -->
  <link rel="manifest" href="/manifest.webmanifest?v=14" crossorigin="use-credentials">
  <meta name="theme-color" content="#090d16">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/assets/trasx-logo-mark.png">
  <link rel="preload" href="/assets/trasx-logo-mark.png" as="image" fetchpriority="high">
  <link rel="preload" href="/assets/trasx-logo.png" as="image">
  <link rel="preload" href="/assets/avatar_placeholder.jpg" as="image">
  <title>TrasX</title>
  <!-- SEO Meta Tags -->
  <meta name="description" content="<%= tText('TrasX is a responsive premium social media dashboard featuring stories, feed, messages, and events with sleek glassmorphism and modern UI design.') %>">
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  <!-- CSS Stylesheet -->
  <link rel="stylesheet" href="/css/styles.css?v=196">
  <% if (typeof isMobileView !== 'undefined' && isMobileView) { %>
  <style>
    .app-header, .mobile-header, .mobile-nav, .left-sidebar, .right-sidebar, .ios-pwa-banner {
      display: none !important;
    }
    .main-layout {
      grid-template-columns: 1fr !important;
      gap: 0 !important;
      padding: 12px 18px 24px 18px !important;
      margin: 0 !important;
      min-height: 100vh !important;
      background-color: var(--bg-app) !important;
    }
    .app-wrapper {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      margin: 0 !important;
      max-width: 100% !important;
      min-height: 100vh !important;
      background-color: var(--bg-app) !important;
    }
    body, html {
      padding: 0 !important;
      margin: 0 !important;
      background-color: var(--bg-app) !important;
      overflow-x: hidden !important;
    }
  </style>
  <% } %>
  <style>
    /* Premium, professional integration for the games page */
    .lobby-setup-card {
      border-radius: 0 !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      padding: 12px 0 !important;
      margin: 0 !important;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .setup-group-label {
      font-family: 'Outfit', sans-serif;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-secondary);
      margin-bottom: 10px;
      display: inline-block;
    }

    /* Game choice options: beautiful premium card style */
    .game-choice-option {
      border-radius: 16px !important;
      border: 1px solid var(--border-color) !important;
      background: var(--bg-card) !important;
      padding: 18px 12px !important;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
      box-shadow: var(--shadow-sm) !important;
    }

    .game-choice-option:hover {
      transform: translateY(-2px) !important;
      border-color: var(--primary) !important;
      box-shadow: var(--shadow-md) !important;
      background: var(--bg-hover) !important;
    }

    .game-choice-option.active {
      border-color: var(--primary) !important;
      background: var(--primary-light) !important;
      box-shadow: 0 8px 24px rgba(24, 119, 242, 0.08) !important;
      transform: translateY(-1px) !important;
    }

    .game-choice-option.active .choice-card-content {
      color: var(--primary) !important;
    }

    /* Sub-choices grid (Adversaire, Type de partie) */
    .sub-choice-option {
      border-radius: 12px !important;
      border: 1px solid var(--border-color) !important;
      background: var(--bg-card) !important;
      padding: 14px 12px !important;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
      box-shadow: var(--shadow-sm) !important;
    }

    .sub-choice-option:hover {
      transform: translateY(-1px) !important;
      background: var(--bg-hover) !important;
    }

    .sub-choice-option.active {
      border-color: var(--primary) !important;
      background: var(--primary-light) !important;
      box-shadow: 0 4px 12px rgba(24, 119, 242, 0.06) !important;
    }

    .sub-choice-option.active .choice-card-content {
      color: var(--primary) !important;
    }

    /* Bot select cards: modern premium card layout */
    .bot-select-card {
      border-radius: 16px !important;
      border: 1px solid var(--border-color) !important;
      background: var(--bg-card) !important;
      padding: 16px 12px !important;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
      box-shadow: var(--shadow-sm) !important;
    }

    .bot-select-card:hover {
      transform: translateY(-3px) !important;
      border-color: var(--primary) !important;
      box-shadow: var(--shadow-md) !important;
    }

    .bot-select-card.active {
      border-color: var(--primary) !important;
      background: var(--primary-light) !important;
      box-shadow: 0 8px 24px rgba(24, 119, 242, 0.1) !important;
    }

    /* Premium inputs and fields */
    #gamePlayerSearchInput {
      border-radius: 12px !important;
      background: var(--bg-input) !important;
      border: 1px solid var(--border-color) !important;
      color: var(--text-primary) !important;
      padding: 0 16px !important;
      height: 48px !important;
      transition: all 0.2s ease !important;
    }

    #gamePlayerSearchInput:focus {
      border-color: var(--primary) !important;
      background: var(--bg-card) !important;
      box-shadow: 0 0 0 3px var(--primary-light) !important;
    }

    #selectedGameOpponentWrapper {
      border-radius: 12px !important;
      background: var(--bg-card) !important;
      border: 1px solid var(--border-color) !important;
      padding: 12px 16px !important;
    }

    #selectedGameOpponentName {
      color: var(--text-primary) !important;
    }

    /* Premium Start Match Button */
    .lobby-start-btn {
      border-radius: 14px !important;
      background: linear-gradient(135deg, var(--primary) 0%, #a855f7 100%) !important;
      color: white !important;
      font-weight: 700 !important;
      font-size: 15px !important;
      letter-spacing: 0.5px !important;
      border: none !important;
      height: 48px !important;
      box-shadow: 0 8px 20px rgba(124, 58, 237, 0.2) !important;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
      margin-top: 10px !important;
      cursor: pointer;
    }

    .lobby-start-btn:hover {
      transform: translateY(-2px) !important;
      box-shadow: 0 12px 28px rgba(124, 58, 237, 0.3) !important;
      opacity: 0.95 !important;
    }

    .lobby-start-btn:active {
      transform: translateY(0) !important;
    }
  </style>
  <!-- Lucide Icons CDN -->
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.407.0/dist/umd/lucide.min.js" defer crossorigin></script>
  <!-- Chess Engine -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js" crossorigin="anonymous"></script>

  <script>
    window.__APP_LOCALE__ = <%- JSON.stringify(typeof locale !== 'undefined' ? locale : 'en') %>;
    window.__APP_I18N__ = <%- JSON.stringify(typeof clientTranslations === 'object' && clientTranslations ? clientTranslations : {}) %>;
    window.__APP_SOURCE_TEXT_I18N__ = <%- JSON.stringify(typeof clientSourceTextTranslations === 'object' && clientSourceTextTranslations ? clientSourceTextTranslations : {}) %>;
    window.__ = function(key, fallback = '') {
      if (window.__APP_I18N__ && typeof window.__APP_I18N__[key] === 'string') {
        return window.__APP_I18N__[key];
      }
      return fallback || key;
    };
    window.__text = function(source, fallback = '') {
      const normalized = String(source || '').trim();
      if (window.__APP_SOURCE_TEXT_I18N__ && typeof window.__APP_SOURCE_TEXT_I18N__[normalized] === 'string') {
        return window.__APP_SOURCE_TEXT_I18N__[normalized];
      }
      return fallback || normalized;
    };
    window.__translateDomText = function(root = document.body) {
      const attributeNames = ['placeholder', 'title', 'aria-label'];
      const shouldSkipElement = (element) => {
        if (!element) return true;
        if (element.closest && element.closest('[data-i18n-skip]')) return true;
        const tagName = element.tagName;
        return tagName === 'SCRIPT' || tagName === 'STYLE' || tagName === 'TEXTAREA' || tagName === 'CODE' || tagName === 'PRE';
      };
      const translateExactText = (value) => {
        const raw = String(value || '');
        const trimmed = raw.trim();
        if (!trimmed || trimmed.length > 180) return raw;
        if (/^(https?:\/\/|www\.)/i.test(trimmed)) return raw;
        const translated = window.__text(trimmed, trimmed);
        if (translated === trimmed) return raw;
        return raw.replace(trimmed, translated);
      };
      const translateNodeText = (textNode) => {
        if (!textNode || !textNode.nodeValue || !textNode.parentElement || shouldSkipElement(textNode.parentElement)) return;
        const nextValue = translateExactText(textNode.nodeValue);
        if (nextValue !== textNode.nodeValue) {
          textNode.nodeValue = nextValue;
        }
      };
      const translateAttributes = (element) => {
        if (!(element instanceof Element) || shouldSkipElement(element)) return;
        attributeNames.forEach((name) => {
          if (!element.hasAttribute(name)) return;
          const current = element.getAttribute(name);
          const next = translateExactText(current);
          if (next !== current) {
            element.setAttribute(name, next);
          }
        });
        if (element.tagName === 'INPUT') {
          const type = String(element.getAttribute('type') || '').toLowerCase();
          if (['button', 'submit', 'reset'].includes(type) && element.value) {
            const nextValue = translateExactText(element.value);
            if (nextValue !== element.value) {
              element.value = nextValue;
            }
          }
        }
      };
      const translateTree = (container) => {
        if (!container) return;
        if (container.nodeType === Node.TEXT_NODE) {
          translateNodeText(container);
          return;
        }
        if (container instanceof Element) {
          translateAttributes(container);
        }
        const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
        let textNode = walker.nextNode();
        while (textNode) {
          translateNodeText(textNode);
          textNode = walker.nextNode();
        }
        if (container.querySelectorAll) {
          container.querySelectorAll('*').forEach(translateAttributes);
        }
      };

      translateTree(root);

      if (!window.__APP_I18N_OBSERVER__ && document.body) {
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.type === 'characterData') {
              translateNodeText(mutation.target);
              return;
            }
            if (mutation.type === 'attributes' && mutation.target instanceof Element) {
              translateAttributes(mutation.target);
              return;
            }
            mutation.addedNodes.forEach((node) => {
              translateTree(node);
            });
          });
        });
        observer.observe(document.body, {
          childList: true,
          subtree: true,
          characterData: true,
          attributes: true,
          attributeFilter: ['placeholder', 'title', 'aria-label', 'value']
        });
        window.__APP_I18N_OBSERVER__ = observer;
      }
    };
    document.addEventListener('DOMContentLoaded', function () {
      window.__translateDomText(document.body);
    });
  </script>
  <!-- Socket.io client -->
  <script src="/socket.io/socket.io.js" defer></script>
  <!-- Lazy loading for images and videos -->
  <script src="/js/lazyMedia.js?v=2" defer></script>
</head>
<%
  const _headView = typeof activeView !== 'undefined' ? activeView : 'feed';
  const _bodyClass = (_headView === 'shorts') ? 'viewing-shorts'
    : (_headView === 'messages') ? 'viewing-messages'
    : (_headView === 'market') ? 'viewing-market'
    : (_headView === 'games') ? 'viewing-games'
    : '';
%>
<body class="<%= _bodyClass %>" data-initial-view="<%= _headView %>" <%= (typeof activeTheme !== 'undefined' && activeTheme === 'dark') ? 'data-theme="dark"' : '' %>>
