PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=weshare

# Clé API BSCScan (Optionnel mais recommandé pour les dépôts)
BSCSCAN_API_KEY=
PEXELS_API_KEY=VOTRE_CLE_PEXELS_ICI

# Configuration Blockchain BSC (pour les retraits automatiques en temps réel)
BSC_PROVIDER_URL=https://bsc-dataseed.binance.org/
PLATFORM_PRIVATE_KEY=VOTRE_CLE_PRIVEE_ICI

# ─── Firebase Cloud Messaging (FCM) — Notifications push mobiles ─────────────
# 1. Aller sur console.firebase.google.com → Paramètres du projet → Comptes de service
# 2. Cliquer "Générer une nouvelle clé privée" → télécharger le fichier JSON
# 3. Placer le fichier JSON dans le dossier du projet (ex: ./firebase-service-account.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=votre-projet-firebase-id
